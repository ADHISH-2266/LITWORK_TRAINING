Output: ["ad","ae","af","bd","be","bf","cd","ce","cf"]
Example 2:
 
Input: digits = ""
Output: []
Example 3:
 
Input: digits = "2"
Output: ["a","b","c"]E




digits = input()

phone = {
    '2': 'abc',
    '3': 'def',
    '4': 'ghi',
    '5': 'jkl',
    '6': 'mno',
    '7': 'pqrs',
    '8': 'tuv',
    '9': 'wxyz'
}

if digits == "":
    print([])
else:
    result = [""]

    for digit in digits:
        new = []

        for r in result:
            for ch in phone[digit]:
                new.append(r + ch)

        result = new

    print(result)
